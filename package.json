{
  "name": "csv-finder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "benchmark": "node --experimental-strip-types --expose-gc scripts/benchmark.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css}\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18.0"
  }
}
